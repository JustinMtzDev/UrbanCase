DATABASE_URL=postgresql://usuario:password@host:5432/urbancase
PORT=3000

# Seguridad
NODE_ENV=development
# En producción: NODE_ENV=production
SESSION_TTL_MS=43200000
LOGIN_RATE_MAX=10
# Orígenes permitidos (separados por coma). Vacío = permitir todos (solo desarrollo).
# En producción:
# CORS_ORIGINS=https://urbancase.com.mx,https://www.urbancase.com.mx


# Mercado Pago Point (impresión de tickets). Se pueden agregar después.
# MP_ACCESS_TOKEN=APP_USR-...
# MP_TERMINAL_ID=NEWLAND_N950__N950NCB...
